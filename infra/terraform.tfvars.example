# 复制为 terraform.tfvars 后按需修改。
# 桶名在全球范围内唯一：留空时脚本会自动追加随机后缀，通常无需手工指定。

region = "cn-north-4"

name_prefix = "obsfast"

# 已有桶可在此显式指定；留空表示新建
# source_bucket_name    = "my-existing-bucket"
# inventory_bucket_name = "my-inventory-bucket"

enable_versioning = false

# ⚠️ 默认关闭：该开关对应 KMS 默认加密，开启后列举结果中的 ETag 不再是内容摘要，
#    「按内容标识比对」会失效；同时该桶不能再作为桶清单的投递目标。
enable_encryption = false

# 清单文件保留天数
inventory_lifecycle_days = 30

# 未完成分段上传的清理周期（天）
abort_multipart_days = 7

# 源桶容量上限（字节）；0 表示不限制
bucket_quota = 0

tags = {
  project = "obsfast"
  owner   = "public-cloud-ops"
}
